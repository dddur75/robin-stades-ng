{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robin-des-stades.invalid/schemas/historical-coverage-artifact-v1.json",
  "title": "Historical coverage denominator artifacts V1",
  "$defs": {
    "nullable_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "nullable_rate_value": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "value", "status", "grain"],
      "properties": {
        "numerator": {"$ref": "#/$defs/nullable_count"},
        "denominator": {"$ref": "#/$defs/nullable_count"},
        "value": {"$ref": "#/$defs/nullable_rate_value"},
        "status": {"enum": ["KNOWN", "UNKNOWN", "EMPTY_VALID", "NOT_APPLICABLE"]},
        "grain": {"type": "string", "minLength": 1}
      }
    },
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_completion", "normalization_integrity", "content_presence"],
      "properties": {
        "scope_completion": {"$ref": "#/$defs/rate"},
        "normalization_integrity": {"$ref": "#/$defs/rate"},
        "content_presence": {"$ref": "#/$defs/rate"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "definition_hash",
        "scope",
        "competition",
        "season",
        "family",
        "grain",
        "distinct_key",
        "population_kind",
        "evaluation_level",
        "closure_state",
        "reason_codes",
        "advertised_coverage",
        "expected_count",
        "received_count",
        "empty_valid_count",
        "invalid_count",
        "coverage_percent",
        "null_rate",
        "source_endpoint",
        "payload_hash",
        "receipt_hash",
        "temporal_class",
        "gate",
        "gate_reason",
        "rates",
        "diagnostics",
        "lineage_hash",
        "cell_hash"
      ],
      "properties": {
        "cell_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "definition_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scope": {"const": "P0_2020_2025"},
        "competition": {"type": "string", "minLength": 1},
        "season": {"type": "integer"},
        "family": {"type": "string", "minLength": 1},
        "grain": {"type": "string", "minLength": 1},
        "distinct_key": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "population_kind": {"enum": ["SYNTHETIC", "SAMPLE", "FULL_SCOPE", "P0_FULL"]},
        "evaluation_level": {"enum": ["E0", "E1", "E2", "E3", "E4"]},
        "closure_state": {
          "enum": [
            "OPEN_NOT_EVALUATED",
            "OPEN_MISSING_SCOPE",
            "OPEN_CLASSIFICATION_AMBIGUOUS",
            "OPEN_CONFLICTING_DUPLICATE",
            "DENOMINATOR_CLOSED_FULL_SCOPE"
          ]
        },
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "advertised_coverage": {"type": ["boolean", "null"]},
        "expected_count": {"$ref": "#/$defs/nullable_count"},
        "received_count": {"$ref": "#/$defs/nullable_count"},
        "empty_valid_count": {"$ref": "#/$defs/nullable_count"},
        "invalid_count": {"$ref": "#/$defs/nullable_count"},
        "coverage_percent": {"$ref": "#/$defs/nullable_rate_value"},
        "null_rate": {"$ref": "#/$defs/nullable_rate_value"},
        "source_endpoint": {"type": "string", "minLength": 1},
        "payload_hash": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "receipt_hash": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "temporal_class": {"type": "string", "minLength": 1},
        "gate": {"type": "string", "minLength": 1},
        "gate_reason": {"type": "string", "minLength": 1},
        "rates": {"$ref": "#/$defs/rates"},
        "diagnostics": {"type": "object"},
        "lineage_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cell_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "private_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "scope",
        "competition",
        "season",
        "family",
        "grain",
        "distinct_key",
        "advertised_coverage",
        "expected_count",
        "received_count",
        "empty_valid_count",
        "invalid_count",
        "coverage_percent",
        "null_rate",
        "source_endpoint",
        "payload_hash",
        "receipt_hash",
        "temporal_class",
        "gate",
        "gate_reason",
        "closure_state",
        "reason_codes",
        "rates",
        "cell_hash"
      ],
      "properties": {
        "cell_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scope": {"const": "P0_2020_2025"},
        "competition": {"type": "string", "minLength": 1},
        "season": {"type": "integer"},
        "family": {"type": "string", "minLength": 1},
        "grain": {"type": "string", "minLength": 1},
        "distinct_key": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "advertised_coverage": {"type": ["boolean", "null"]},
        "expected_count": {"$ref": "#/$defs/nullable_count"},
        "received_count": {"$ref": "#/$defs/nullable_count"},
        "empty_valid_count": {"$ref": "#/$defs/nullable_count"},
        "invalid_count": {"$ref": "#/$defs/nullable_count"},
        "coverage_percent": {"$ref": "#/$defs/nullable_rate_value"},
        "null_rate": {"$ref": "#/$defs/nullable_rate_value"},
        "source_endpoint": {"const": "SANITIZED_IN_PRIVATE_PROJECTION"},
        "payload_hash": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "receipt_hash": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "temporal_class": {"type": "string"},
        "gate": {"type": "string"},
        "gate_reason": {"type": "string"},
        "closure_state": {"type": "string"},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "rates": {"$ref": "#/$defs/rates"},
        "cell_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "p0_grid": {
      "type": "object",
      "required": [
        "schema_version",
        "grid_hash",
        "cell_count",
        "invariants",
        "weighted_aggregates",
        "cells",
        "proof_hash"
      ],
      "properties": {
        "schema_version": {"const": "p0-denominator-grid-v1"},
        "cell_count": {"const": 480},
        "cells": {
          "type": "array",
          "minItems": 480,
          "maxItems": 480,
          "items": {"$ref": "#/$defs/cell"}
        }
      }
    },
    "level_proof": {
      "type": "object",
      "required": [
        "schema_version",
        "evaluation_level",
        "population_kind",
        "status",
        "scenario_results",
        "proof_hash"
      ],
      "properties": {
        "schema_version": {"const": "e0-denominator-proof-v1"},
        "evaluation_level": {"const": "E0"},
        "scenario_results": {"type": "array", "minItems": 1}
      }
    },
    "census_manifest": {
      "type": "object",
      "required": [
        "schema_version",
        "manifest_id",
        "run_independent_identity",
        "observed_union",
        "authoritative_p0",
        "proof_hash"
      ],
      "properties": {
        "schema_version": {"const": "coverage-census-manifest-v1"},
        "run_independent_identity": {"const": true},
        "observed_union": {"type": "object"},
        "authoritative_p0": {"type": "object"}
      }
    },
    "gate_report": {
      "type": "object",
      "required": [
        "schema_version",
        "coverage_gate",
        "gates",
        "counts",
        "readiness_verdicts",
        "properties_unlocked",
        "proof_hash"
      ],
      "properties": {
        "schema_version": {"const": "p0-readiness-gates-report-v1"},
        "coverage_gate": {"type": "object"},
        "gates": {"type": "array", "minItems": 10, "maxItems": 10},
        "counts": {"type": "object"},
        "readiness_verdicts": {"type": "array", "minItems": 8, "maxItems": 8},
        "properties_unlocked": {"type": "array"}
      }
    },
    "property_readiness": {
      "type": "object",
      "required": [
        "schema_version",
        "family_readiness",
        "calendar_fatigue",
        "families_exploitable",
        "properties_unlocked",
        "hypergraph_verdict",
        "proof_hash"
      ],
      "properties": {
        "schema_version": {"const": "p0-property-readiness-v1"},
        "family_readiness": {"type": "array", "minItems": 16, "maxItems": 16},
        "calendar_fatigue": {"type": "object"},
        "families_exploitable": {"type": "array"},
        "properties_unlocked": {"type": "array"}
      }
    },
    "closure_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "verdict",
        "closed_cells",
        "open_cells",
        "weighted_aggregates",
        "readiness_verdicts",
        "hypergraph_verdict",
        "proof_hash"
      ],
      "properties": {
        "schema_version": {"const": "denominator-closure-summary-v1"},
        "closed_cells": {"type": "integer", "minimum": 0},
        "open_cells": {"type": "integer", "minimum": 0},
        "weighted_aggregates": {"type": "object"},
        "readiness_verdicts": {"type": "array"}
      }
    },
    "private_projection": {
      "type": "object",
      "required": [
        "schema_version",
        "privacy",
        "summary",
        "weighted_aggregates",
        "navigation_gates",
        "cells",
        "proof_hash"
      ],
      "properties": {
        "schema_version": {"const": "p0-denominator-private-projection-v1"},
        "privacy": {"type": "object"},
        "summary": {"type": "object"},
        "weighted_aggregates": {"type": "object"},
        "navigation_gates": {"type": "object"},
        "cells": {
          "type": "array",
          "minItems": 480,
          "maxItems": 480,
          "items": {"$ref": "#/$defs/private_cell"}
        }
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/p0_grid"},
    {"$ref": "#/$defs/level_proof"},
    {"$ref": "#/$defs/census_manifest"},
    {"$ref": "#/$defs/gate_report"},
    {"$ref": "#/$defs/property_readiness"},
    {"$ref": "#/$defs/closure_summary"},
    {"$ref": "#/$defs/private_projection"}
  ]
}
