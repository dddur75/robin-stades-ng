{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robin-des-stades.invalid/schemas/source-observatory/contribution.schema.json",
  "title": "Dossier fidèle à contribution §04/05 version 3",
  "description": "Immutable evidence lineage. Only necessary authorized excerpts, exact explicit quotes, documented versioned settlement rules. UTC plus original timezone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "publication_url",
    "text_sha256",
    "langue",
    "marche",
    "selection",
    "cote_declaree",
    "cote_observee",
    "statut",
    "raison_non_resolu",
    "extraits_preuve",
    "contribution_id",
    "version_id",
    "author_id",
    "publication_id",
    "preuve_permise",
    "liens_reprise",
    "match_id",
    "certitude_rapprochement",
    "ligne",
    "periode",
    "reglement",
    "bookmaker",
    "categorie",
    "probabilite",
    "selection_key",
    "cote_declaree_provenance",
    "cote_declaree_at",
    "cote_observee_provenance",
    "cote_observee_at",
    "observed_at"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "publication_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/@?#:]+(?::[0-9]+)?(?:[/?#]|$)"
    },
    "text_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "langue": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "marche": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "selection": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "cote_declaree": {
      "$ref": "#/$defs/odds"
    },
    "cote_observee": {
      "$ref": "#/$defs/odds"
    },
    "statut": {
      "enum": [
        "resolu",
        "non_resolu"
      ]
    },
    "raison_non_resolu": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "extraits_preuve": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text_sha256",
          "start",
          "end",
          "text"
        ],
        "properties": {
          "text_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        }
      },
      "maxItems": 5,
      "contains": {
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "minContains": 0,
      "maxContains": 1
    },
    "contribution_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "author_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "publication_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "preuve_permise": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/@?#:]+(?::[0-9]+)?(?:[/?#]|$)"
        },
        {
          "type": "null"
        }
      ]
    },
    "liens_reprise": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "match_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "certitude_rapprochement": {
      "enum": [
        "certaine",
        "probable",
        "non_resolue"
      ]
    },
    "ligne": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "periode": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reglement": {
      "anyOf": [
        {
          "$ref": "#/$defs/rule"
        },
        {
          "type": "null"
        }
      ]
    },
    "bookmaker": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "categorie": {
      "enum": [
        "selection_avec_cote",
        "selection_sans_cote",
        "probabilite_explicite",
        "information_factuelle"
      ]
    },
    "probabilite": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"
    },
    "selection_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "cote_declaree_provenance": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "cote_declaree_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/instant"
        },
        {
          "type": "null"
        }
      ]
    },
    "cote_observee_provenance": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "cote_observee_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/instant"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "$ref": "#/$defs/instant"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"categorie": {"const": "selection_avec_cote"}}},
      "then": {"anyOf": [
        {"properties": {"cote_declaree": {"type": "string"}}},
        {"properties": {"cote_observee": {"type": "string"}}}
      ]}
    },
    {
      "if": {
        "properties": {
          "statut": {
            "const": "resolu"
          }
        }
      },
      "then": {
        "properties": {
          "raison_non_resolu": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "raison_non_resolu": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cote_declaree": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "cote_declaree_provenance": {
            "type": "null"
          },
          "cote_declaree_at": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "cote_declaree_provenance": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "cote_declaree_at": {
            "$ref": "#/$defs/instant"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cote_observee": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "cote_observee_provenance": {
            "type": "null"
          },
          "cote_observee_at": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "cote_observee_provenance": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "cote_observee_at": {
            "$ref": "#/$defs/instant"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "preuve_permise": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "extraits_preuve": {
            "items": {
              "properties": {
                "text": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "match_id": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "certitude_rapprochement": {
            "const": "non_resolue"
          }
        }
      },
      "else": {
        "properties": {
          "certitude_rapprochement": {
            "enum": [
              "certaine",
              "probable"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "categorie": {
            "const": "probabilite_explicite"
          }
        }
      },
      "then": {
        "properties": {
          "probabilite": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "probabilite": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "categorie": {
            "const": "selection_sans_cote"
          }
        }
      },
      "then": {
        "properties": {
          "cote_declaree": {
            "type": "null"
          },
          "cote_observee": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "odds": {
      "type": [
        "string",
        "null"
      ],
      "description": "Explicit decimal odds >= 1; never infer, substitute, or reconstruct an absent value.",
      "pattern": "^(?:[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "instant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utc",
        "origin_timezone",
        "origin_offset_seconds"
      ],
      "properties": {
        "utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT.*\\+00:00$"
        },
        "origin_timezone": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "origin_offset_seconds": {
          "type": "integer",
          "exclusiveMinimum": -86400,
          "exclusiveMaximum": 86400
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "version",
        "document_url",
        "evidence_sha256",
        "market",
        "period",
        "postponed"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "document_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/@?#:]+(?::[0-9]+)?(?:[/?#]|$)"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "market": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "period": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "postponed": {
          "enum": [
            "en_attente",
            "rembourse"
          ]
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_id",
        "certainty",
        "evidence_sha256"
      ],
      "properties": {
        "publication_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "certainty": {
          "enum": [
            "attestee",
            "similarite"
          ]
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "certainty": {
                "const": "attestee"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      ]
    }
  }
}
